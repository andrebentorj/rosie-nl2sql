# Rosie settings. Copy this file to .env and fill in the first block.
#
# The first block is what a small installation sets. Everything under "Full reference" is
# commented out and shows the default: uncomment a line only to change it.
# `npm run doctor` checks the result; `npm run doctor -- --settings` prints every setting in
# effect, where it comes from, with secrets redacted.
#
# Values are read strictly: a number is digits only, in the unit its name says (_MS is
# milliseconds), so AI_QUERY_TIMEOUT_MS=10s or 1e3 stops the server at startup with the
# setting and the accepted range named. A list setting (LOG_LEVEL, DB_DIALECT,
# ROSIE_RATE_LIMIT_STORE...) refuses a value it does not know. A ROSIE_ name Rosie does not
# read, or an AI_ or DB_ name one typo away from a setting, is warned at startup with the
# closest setting ("did you mean").

# ════════════════════════════ Minimum to run ════════════════════════════

# Key of the model provider (OpenAI, or any OpenAI-compatible endpoint: see AI_BASE_URL below).
OPENAI_API_KEY=sk-...
# The model. Default gpt-6.1-terra; uncomment only to change it (docs/MODELS.md).
# AI_MODEL=gpt-6.1-terra

# The database: mysql (default), postgres or mssql (SQL Server).
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
# The database whose data people ask about.
DB_DATABASE=your_database_name
# The account of Rosie's own tables (audit, certificates, feedback). In production one with
# SELECT, INSERT on DB_ENGINE_DATABASE only, never an administrator.
DB_USER=root
DB_PASSWORD=
# Where those tables live (recommended: a database of their own). Unset: in DB_DATABASE.
# DB_ENGINE_DATABASE=rosie
# The read-only account every question runs as (SELECT only). Unset: DB_USER, and every
# question is refused until it is a SELECT-only account.
DB_RO_USER=rosie_readonly
DB_RO_PASSWORD=
# TLS to the database. Set it when the database is not on this host or a private network:
# true (verify the certificate) or no-verify.
# DB_SSL=true

# Absolute path of the context directory (`npm run init` writes one).
ROSIE_CONTEXT_DIR=/absolute/path/to/your-project/rosie-context

# Bearer token callers send. Required in production (with NODE_ENV=production a missing token
# refuses every request). A long random string: `openssl rand -hex 32`.
ROSIE_API_TOKEN=
# Signs the answer handles of export and explain. Unset, they stop working at every restart
# and one process refuses the handles of another. 32 random characters or more.
ROSIE_HANDLE_SECRET=
# Origins of the pages that embed the widget, comma-separated, each scheme://host[:port] with
# no path and no trailing slash. A page from another origin gets HTTP 403 naming its origin.
ROSIE_CORS_ORIGIN=http://localhost:4200
# Behind a reverse proxy or load balancer: the number of proxies (usually 1).
# TRUST_PROXY=1
# On a server people use (the Docker image sets it).
# NODE_ENV=production

# ════════════════════════════ Full reference ════════════════════════════
# Every other setting, commented out, at its default.

# ─── Server ───
# HTTP port; 0 takes any free port.
# ROSIE_PORT=3001
# Origins allowed to call the API from a browser: the origin of the pages that embed the
# widget. Several: comma-separated. "*" is refused. A request from an origin that is not
# listed is refused, through a reverse proxy too.
# ROSIE_CORS_ORIGIN=http://localhost:4200
# Behind a reverse proxy (nginx/ALB), set to the number of proxy hops (usually 1) so
# rate limiting sees the real client IP instead of the proxy's. Without it, ALL users
# behind the proxy share one rate-limit bucket. Never use "true" in production: it
# trusts any client-supplied X-Forwarded-For and makes limits spoofable.
# TRUST_PROXY=1

# Set to "production" to make auth FAIL-CLOSED: with NODE_ENV=production and no
# ROSIE_API_TOKEN, every request is refused (503) instead of running unauthenticated.
# Anything else (or unset) is treated as development; `npm run doctor` warns about it.
# NODE_ENV=production

# ─── Auth (production: set to a long random string; dev: leave empty) ───
# ROSIE_API_TOKEN=

# ─── Verified identity (JWT). Needed for row policies; optional otherwise ───
# When ROSIE_JWT_ISSUER is set, a bearer token that is a JWT is verified (signature, issuer,
# audience, expiry) and its claims become the identity of the request. ROSIE_API_TOKEN keeps
# working alongside it for callers without a user token, but carries no claims.
# Only asymmetric algorithms are accepted. See docs/IDENTITY.md.
# ROSIE_JWT_ISSUER=https://login.example.com/
# ROSIE_JWT_AUDIENCE=rosie
# ROSIE_JWT_JWKS_URL=https://login.example.com/.well-known/jwks.json
# Alternative to the URL: the public key set itself, as JSON (air-gapped installs).
# ROSIE_JWT_JWKS=
# ROSIE_JWT_ALGORITHMS=RS256,ES256,PS256,EdDSA
# ROSIE_JWT_USER_CLAIM=sub
# ROSIE_JWT_NAME_CLAIM=name
# Expose a namespaced claim under the short name row policies use:
# ROSIE_JWT_CLAIM_MAP={"tenant_id":"https://example.com/tenant"}
# MCP over HTTP only: a scope the token must carry (default: any valid token for the audience).
# ROSIE_MCP_HTTP_REQUIRED_SCOPE=

# ─── Chat page with sign-in (off unless true). See docs/CHAT_PAGE.md ───
# Rosie serves its own chat page at / and people sign in with Microsoft Entra ID, Google
# Workspace or any OpenID Connect provider. The static API token never reaches the browser:
# the page uses a sealed, HttpOnly session cookie, and every question runs as the person who
# signed in (row policies, audit trail). On the chat page the user id is the verified e-mail
# address unless ROSIE_JWT_USER_CLAIM is set; ROSIE_JWT_NAME_CLAIM and ROSIE_JWT_CLAIM_MAP
# apply as for JWT. Register the redirect URL <ROSIE_CHAT_PUBLIC_URL>/auth/callback.
# ROSIE_CHAT_PAGE=false
# ROSIE_CHAT_PUBLIC_URL=https://rosie.example.com
# 32 characters or more (openssl rand -base64 48). Changing it signs everyone out.
# ROSIE_CHAT_SESSION_SECRET=
# ROSIE_CHAT_SESSION_HOURS=8
# ROSIE_CHAT_IDLE_MINUTES=60
# With exactly one provider, opening the page goes straight to it (no sign-in screen). On the
# first visit Rosie also tries a silent sign-in (prompt=none) with that provider, or with the
# one used last; it never repeats it in a loop and never right after a sign-out.
# ROSIE_CHAT_AUTO_REDIRECT=true
# Who may sign in. Both lists apply when both are set. Google needs the domain list.
# ROSIE_CHAT_ALLOWED_DOMAINS=example.com
# ROSIE_CHAT_ALLOWED_GROUPS=
# Microsoft Entra ID (single tenant: the Directory (tenant) ID, a GUID):
# ROSIE_OIDC_MICROSOFT_TENANT=
# ROSIE_OIDC_MICROSOFT_CLIENT_ID=
# ROSIE_OIDC_MICROSOFT_CLIENT_SECRET=
# Google Workspace:
# ROSIE_OIDC_GOOGLE_CLIENT_ID=
# ROSIE_OIDC_GOOGLE_CLIENT_SECRET=
# Any OpenID Connect provider (Okta, Auth0, Keycloak, ...); the button reads "Sign in with <label>":
# ROSIE_OIDC_ISSUER=https://login.example.com
# ROSIE_OIDC_CLIENT_ID=
# ROSIE_OIDC_CLIENT_SECRET=
# ROSIE_OIDC_LABEL=SSO
# Its address counts only with email_verified true. For a provider that never sends that claim,
# this trusts the address anyway: a risk, since anyone who can set their own address there
# could sign in as someone else. Off by default.
# ROSIE_OIDC_EMAIL_UNVERIFIED_OK=false
# Sign-out also ends the session at the provider (when it publishes end_session_endpoint;
# register <ROSIE_CHAT_PUBLIC_URL>/ as a post-logout redirect URL there). Off by default.
# ROSIE_CHAT_PROVIDER_SIGNOUT=false

# ─── Scheduled answers (off unless true). See docs/SCHEDULED_ANSWERS.md ───
# Approved queries run on a schedule (scheduled-answers.json in the context directory) and
# their result is SENT OUT of this installation, by e-mail and to webhooks, with its verdict
# and checks. No model is called. With the default database lock, create the table
# rosie_scheduled_run (db/schema.sql) first: replicas claim each run there, so it is sent once.
# ROSIE_SCHEDULES=false
# database (the default): every replica may run schedules. single: only one replica has
# ROSIE_SCHEDULES=true, and runs on time even while the engine database does not answer.
# ROSIE_SCHEDULE_LOCK=database
# Attempts of a run and of each delivery, and the wait before the first retry (it doubles).
# ROSIE_SCHEDULE_MAX_ATTEMPTS=4
# ROSIE_SCHEDULE_RETRY_BASE_MS=60000
# A run missed while no replica was up is made this late, if nobody made it (0: never).
# ROSIE_SCHEDULE_CATCHUP_MINUTES=30
# The only e-mail domains and webhook hosts schedules may send to, comma-separated. Unset: any.
# ROSIE_SCHEDULE_EMAIL_DOMAINS=example.com
# ROSIE_SCHEDULE_WEBHOOK_HOSTS=hooks.example.com
# Signs every webhook body (HMAC-SHA256, 32+ characters: openssl rand -base64 48).
# ROSIE_WEBHOOK_SECRET=
# The e-mail channel. starttls (port 587) or tls (port 465); none only for a relay on localhost.
# ROSIE_SMTP_HOST=smtp.example.com
# ROSIE_SMTP_PORT=587
# ROSIE_SMTP_SECURITY=starttls
# ROSIE_SMTP_USER=
# ROSIE_SMTP_PASSWORD=
# ROSIE_SMTP_FROM=Rosie <rosie@example.com>
# A Slack channel of a schedule ({ "type": "slack", "channel": "C0123ABCD" }) posts with
# ROSIE_SLACK_BOT_TOKEN, below; Rosie must be a member of that channel.

# ─── Slack (off unless true). See docs/SLACK.md and deploy/slack/manifest.json ───
# People ask Rosie in Slack: a mention in a channel, a direct message, /rosie. Each answer
# goes through the same checks as the widget, as the person who asked (their e-mail address,
# looked up in Slack by Rosie), and is audited with the user agent "slack (<team>/<channel>)".
# ROSIE_SLACK=false
# From the app's pages at api.slack.com/apps: Basic Information, Signing Secret; and
# OAuth & Permissions, Bot User OAuth Token (xoxb-...). The token is also what scheduled
# answers use to post to a Slack channel, with ROSIE_SLACK on or off.
# ROSIE_SLACK_SIGNING_SECRET=
# ROSIE_SLACK_BOT_TOKEN=
# Required: the Workspace ID (T...) the app is installed in. Anything else is refused.
# ROSIE_SLACK_WORKSPACES=T0123ABCD
# Channel IDs (C...) where Rosie answers and where schedules may post. Unset: any channel
# Rosie is invited to. Everyone in a channel sees an answer given there.
# ROSIE_SLACK_ALLOWED_CHANNELS=C0123ABCD
# Direct messages to Rosie (on by default).
# ROSIE_SLACK_DIRECT_MESSAGES=true
# Who may ask: member IDs (U...) or e-mail addresses, OR anyone in these e-mail domains.
# With neither set, every member of the workspace may ask (guests never, unless allowed).
# ROSIE_SLACK_ALLOWED_USERS=
# ROSIE_SLACK_ALLOWED_DOMAINS=example.com
# ROSIE_SLACK_ALLOW_GUESTS=false
# Where an answer asked in a channel goes. auto (default): to the asker's direct messages when
# the context has row policies (each person sees other rows), in the thread otherwise.
# thread: in the thread, for everyone in the channel. private: always to the asker's DMs.
# ROSIE_SLACK_CHANNEL_ANSWERS=auto
# Earlier questions of a thread given with a follow-up (0 to 10), rows shown in a message
# (a larger result goes as a CSV file), how long a member's address is kept (seconds).
# ROSIE_SLACK_THREAD_TURNS=6
# ROSIE_SLACK_ROWS_INLINE=10
# ROSIE_SLACK_IDENTITY_CACHE_SECONDS=300
# Slack's Web API. Change it only for a test double.
# ROSIE_SLACK_API_URL=https://slack.com/api

# ─── Microsoft Teams bot (off unless true). See docs/TEAMS.md ───
# People ask Rosie in Teams and get the governed answer, verdict first. The Bot Framework posts
# to https://<your host>/api/messages (the Azure Bot resource's messaging endpoint).
# ROSIE_TEAMS=false
# The bot's Entra ID app registration and your directory (GUIDs from the Azure portal).
# ROSIE_TEAMS_APP_ID=
# ROSIE_TEAMS_APP_SECRET=
# ROSIE_TEAMS_TENANT=
# single (the default): only your directory. multi needs the list of directories it serves.
# ROSIE_TEAMS_APP_TYPE=single
# ROSIE_TEAMS_ALLOWED_TENANTS=
# Who may ask: sign-in name domains, sign-in names, or members of Entra ID groups (object IDs;
# Rosie then reads groups from Microsoft Graph: application permission GroupMember.Read.All).
# ROSIE_TEAMS_ALLOWED_DOMAINS=example.com
# ROSIE_TEAMS_ALLOWED_USERS=
# ROSIE_TEAMS_ALLOWED_GROUPS=
# Where: personal chats (default on) and the channels or group chats listed here (default none).
# ROSIE_TEAMS_PERSONAL=true
# ROSIE_TEAMS_CHANNELS=
# Where an answer asked in a channel goes. auto (the default): privately to the person who asked
# (a personal chat with the bot) when the context has row policies, in the thread otherwise.
# thread or private force one or the other.
# ROSIE_TEAMS_CHANNEL_ANSWERS=auto
# Rows shown in a message (the rest: a CSV file in a personal chat, else the chat page), and
# earlier turns kept per person and conversation (in memory, 30 minutes).
# Answers as Adaptive Cards (verdict band, table, buttons); false sends the plain text only.
# ROSIE_TEAMS_CARDS=true
# ROSIE_TEAMS_MESSAGE_ROWS=10
# ROSIE_TEAMS_HISTORY_TURNS=3
# Connector of scheduled deliveries, and the hosts allowed to receive the bot's app token.
# ROSIE_TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/
# ROSIE_TEAMS_CONNECTOR_HOSTS=smba.trafficmanager.net

# ─── MCP over Streamable HTTP (stdio needs none of these) ───
# Off unless true. Stateless transport behind bearer auth; bind to loopback and put a TLS
# proxy in front. See docs/MCP_SERVER.md "Remote transport".
# ROSIE_MCP_HTTP_ENABLED=false
# ROSIE_MCP_HTTP_HOST=127.0.0.1
# ROSIE_MCP_HTTP_PORT=3002
# URL clients use (what the proxy exposes). When set, tokens are audience-bound to it
# (RFC 8707): a token minted for another resource is refused.
# ROSIE_MCP_HTTP_PUBLIC_URL=
# STATIC bearer token, used only when ROSIE_JWT_ISSUER is not set (preview, local trials).
# Min 24 chars; one identity, no claims. With JWT configured, tokens are verified instead.
# ROSIE_MCP_HTTP_TOKEN=

# Identity recorded for questions arriving through the local MCP server (stdio). Audit and
# handle ownership only, never authorization: over stdio the trust boundary is the machine.
# ROSIE_MCP_USER=mcp-local

# Key that signs the answer handles /export and /explain authorize with. Minimum 16 chars.
# Unset, a random key is generated per process: handles then stop working after a restart
# and are NOT accepted by a sibling replica, so set this before running more than one
# instance. Rotating it invalidates every outstanding handle (worst case: users re-run a
# question), so rotation is cheap.
# ROSIE_HANDLE_SECRET=

# Counters for a monitoring system, in the Prometheus text format, at
# GET /api/assistant/metrics (docs/MONITORING.md). Off while this is unset (the route answers
# 404). Set a long random value and give it to the scraper as a bearer token. It is a separate
# secret from ROSIE_API_TOKEN on purpose: it can read counters and cannot ask a question.
# ROSIE_METRICS_TOKEN=

# Opens POST /api/assistant/admin/reload, which rebuilds the context from its directory and
# puts it in service without a restart (docs/OPERATIONS.md). Off while this is unset (404).
# A separate secret again: the host application's API token cannot swap the catalog.
# Without it, a reload is still available as a signal: docker kill --signal=HUP <container>.
# The same token opens the administration console at /api/assistant/admin/console.
# ROSIE_ADMIN_TOKEN=
#
# Administrators can sign in as themselves instead of sharing that token. With
# ROSIE_JWT_ISSUER configured (above), name the claim that carries the administrator role and
# the value it must hold. A token that is valid and lacks the role is refused (403), so a
# token issued for asking questions opens nothing here. The name on every change then comes
# from the verified token. Leave ROSIE_ADMIN_TOKEN unset to accept sign-in only. The claim
# may be a string, a space-separated string or a list. There is no default on purpose.
# ROSIE_ADMIN_JWT_CLAIM=roles
# ROSIE_ADMIN_JWT_VALUE=rosie-admin
# The console is read-only unless ROSIE_ADMIN_WRITE=true. With it, a person holding the admin
# token can approve an answer of the review queue as an approved query, rewrite the
# description of a table or column, and mark an answer as looked at. It cannot change which
# tables are readable, the masked columns, the row policies or the prompt. The context
# directory must be writable by the server for the first two (docs/OPERATIONS.md).
# ROSIE_ADMIN_WRITE=false

# Certify a SQL statement the caller wrote: POST /api/assistant/certify and the MCP tool
# certify_sql. The statement is run with no model involved and comes back with its Answer
# Certificate. OFF by default: everywhere else a caller asks in words and never hands the
# engine SQL. With this on, anyone holding the API credential can run any SELECT the
# validator accepts. It stays read-only, limited to the catalog, the unmasked columns and
# the caller's row policies; what changes is who writes the statement (docs/CERTIFICATE.md).
# `npm run certify` (docs/SECOND_OPINION.md) needs none of this: it runs in its own process
# with these settings. Read only by that command, never by the server: ROSIE_CERTIFY_USER
# (the user its audit rows carry, default cli:<login>) and ROSIE_CERTIFY_TOKEN (the
# credential it sends with --url).
# ROSIE_CERTIFY_SQL=false

# ─── AI ───
# Provider-pluggable via an OpenAI-compatible wire format.
#   • Default (OpenAI):   leave AI_BASE_URL empty, AI_MODEL=gpt-6.1-terra, OPENAI_API_KEY=sk-...
#   • Claude (Anthropic): AI_BASE_URL=https://api.anthropic.com/v1/
#                         AI_MODEL=claude-haiku-5-5   (or claude-sonnet-5-5)
#                         OPENAI_API_KEY=sk-ant-...   (the var name stays OPENAI_API_KEY)
#   • Any gateway (OpenRouter, LiteLLM): set AI_BASE_URL to its endpoint + matching key/model.
# AI_BASE_URL=
# OPENAI_API_KEY=sk-...
# gpt-6.1-terra is the default and what the published figures are defended with: about one
# US cent per question and about 86% right on the public benchmark. gpt-6-luna costs a
# fifth to an eighth and answered about 54% there: for high volume and simple questions,
# after measuring it on your own (docs/MODELS.md). The server says so at start when a
# small model is set.
# AI_MODEL=gpt-6.1-terra
# Kill switch: set to false (and restart) to disable the routes that answer or record
# (/ask, /export, /explain, /feedback, /certify, which then answer 404). It is the
# documented emergency stop. /project-info, /health, /widget.js, /metrics and /admin stay up,
# and /health answers 503 "unavailable" while it is off. On by default since 1.33.0 (it was
# off when unset, so a deployment that passed its settings by hand refused every question).
# AI_ASSISTANT_ENABLED=true
# Per-IP limits. Each endpoint group (/ask, /export, /explain, /feedback, /certify) counts
# against its OWN bucket with these same ceilings.
# AI_MAX_QUERIES_PER_HOUR=100
# AI_MAX_QUERIES_PER_DAY=1000
# Circuit breaker for the AI provider (consecutive infra failures before
# short-circuiting, and cooldown before retrying).
# AI_CIRCUIT_BREAKER_THRESHOLD=5
# AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000
# Per-statement DB timeout for AI-generated queries, in ms, on the read-only pool
# (MAX_EXECUTION_TIME on MySQL, statement_timeout on PostgreSQL, the request timeout of the
# connection on SQL Server). Raise for deployments with heavy reports. From 1000 to 3600000.
# AI_QUERY_TIMEOUT_MS=10000
# Max tokens the model may generate per reply (sent as max_completion_tokens).
# AI_MAX_TOKENS=2048
# Sampling temperature. Unset = model-aware default: 0 for the gpt-4 generation (historical
# behaviour), omitted for everything else (current models reject an explicit value unless
# reasoning is off). Set explicitly to override.
# AI_TEMPERATURE=
# Reasoning effort for models that have one. Unset = 'none' for gpt-5+ families (the only
# value that allows function tools on chat.completions) and omitted for older models, which
# reject the argument. Run `node test/provider/smoke.js` after changing model or provider.
# AI_REASONING_EFFORT=
# Max characters accepted in a single question; longer ones are refused before the LLM.
# The default leaves room for a question that carries its own context (definitions, a list
# of names). The widget reads the limit from /project-info.
# AI_MAX_INPUT_LENGTH=2000
# Where the two quotas above are counted. memory (default): in each process, so N replicas
# allow N times each quota. database: in the engine database (table rosie_rate_limit, created
# by db/schema*.sql), one number for the whole installation. If that table cannot be reached
# the process counts in memory and says so in the log.
# ROSIE_RATE_LIMIT_STORE=memory
# Simultaneous in-flight /ask, /export, /explain and /certify requests. This one is PER PROCESS on
# purpose: it protects the process, and capacity grows with replicas.
# AI_CONCURRENCY_LIMIT=3

# ─── Per-request ceilings (bound the work INSIDE one question, unlike the rate
#     limits above, which bound how many questions arrive) ───
# Loop turns the model may take before it is forced to answer.
# AI_MAX_TOOL_CALLS=20
# DB-touching queries per question. execute_query and validate_query each get their own
# bucket with this same ceiling; further attempts are refused and the model must answer.
# AI_MAX_QUERIES_PER_REQUEST=5
# Accumulated LLM tokens per question before a final answer is forced. 0 = OFF.
# The real cost guard when AI_BASE_URL points at an expensive model.
# AI_MAX_TOTAL_TOKENS=0
# Rows of a query result serialized back to the MODEL (the user always gets the full
# result). Default 30. 0 = OFF, meaning the whole result goes into the context.
# AI_LLM_RESULT_MAX_ROWS=30

# ─── Schema retrieval (large catalogs only) ───
# Catalogs with this many tables or fewer are always sent whole, byte-identical to the
# baseline prompt. Above it, the prompt is rebuilt with only the relevant tables.
# 0 disables the feature entirely. The security allowlist is NEVER affected by selection.
# AI_SCHEMA_MAX_TABLES=40
# Upper bound on how many tables the selector may pick for one question.
# AI_SCHEMA_TOPK=15
# Inline every table's (unmasked) column names, type family and enum codes in the prompt
# catalog, so the model writes SQL without a describe_table call per table. Costs a few
# thousand cached prompt tokens; saves one or two LLM round-trips per question.
# AI_CATALOG_COLUMNS=true
# With the inline columns, also show each column's description from the catalog, in brackets
# after its name (cut at 100 characters). Without it a description is read only when the model
# calls describe_table. Costs prompt tokens in proportion to how much the catalog describes.
# AI_CATALOG_DESCRIPTIONS=false
# With the inline columns, show each column's data note (`profileNote` in the catalog), in
# braces after the name: how its data records a missing or special value (0 for "not
# recorded", "-", numbers kept as text, codes with leading zeros). `npm run profile-columns`
# writes the notes from the data; a catalog without notes is unaffected. Default ON.
# AI_CATALOG_PROFILE=true

# Answer Certificate: deterministic post-answer checks (fan-out, nonexistent filter
# value, no-op filter, partial period) shipped to the client with every answer.
# Read-only probes, no LLM cost. Set to false to disable.
# AI_ANSWER_CHECKS=true
# Independent double derivation: re-derives single-value aggregates over a join by a
# deduplicated route and compares the two figures, which gives the CROSS_CHECKED and
# CONTRADICTED verdicts. Costs one extra read-only query on qualifying answers, no LLM.
# Requires the cross_check column of rosie_answer_certificate, which the schema files create;
# an installation older than that column adds it once (docs/INSTALL.md, "Upgrading").
# Default ON; false turns it off.
# AI_CROSS_CHECK=true
# Second attempt guided by the certificate: when the checks name a structural defect in the
# final query (inflated total, filter value that does not exist, declared metric computed
# another way), the evidence is handed back to the model once, before the answer is returned.
# The first answer is kept unless the second one checks out better. Costs one or two extra
# model calls on the answers it applies to. Default ON; false turns it off.
# AI_CERTIFICATE_REPAIR=true
# The same second attempt where the context declares nothing about the column: when a total,
# average or count differs between the joined rows and the distinct records, both figures go
# back to the model as a question, and its second answer is accepted only when it returns
# the figure over distinct records under the same filters. Worth turning on with a small
# model, whose answers carrying that difference are usually wrong; a strong model is usually
# right the first time. The same setting sends back an average that counts zeros where 0 may
# stand for "not recorded", and accepts a second answer only when it returns the average
# without those rows. Default OFF.
# AI_CERTIFICATE_REPAIR_UNDECLARED=false
# Question review: a model reads the question, the final statement, the first rows it returned
# and the values held by the columns it filters on, and says whether the statement returns
# what was asked. It is an opinion returned as `questionReview`, never part of the
# certificate. When it says the statement does not answer the question, that sentence goes
# back to the model once (AI_QUESTION_REVIEW_REPAIR=false keeps the review without the second
# attempt). One extra model call per answer. Use a stronger model than AI_MODEL to review:
# a model reviewing its own query finds little. Measure it on your own questions first: it
# helped on one benchmark and not on another (docs/CERTIFICATE.md). Default OFF.
# AI_QUESTION_REVIEW=false
# AI_QUESTION_REVIEW_MODEL=
# AI_QUESTION_REVIEW_REPAIR=true
# UNION ALL between the branches of a derived table or WITH body (a total across tables of
# the same shape). Each branch passes the whole validator on its own and stays under the
# allowlist, the masked columns and the row policies. Every other set operation is refused
# whatever this says. Default ON; false refuses UNION ALL too.
# AI_UNION_ALL=true
# Wire API for model calls: chat (chat completions, what every OpenAI-compatible gateway
# speaks) or responses. Leave unset: the engine starts on chat and switches a model to
# responses by itself when the provider says its function tools need it (gpt-6.1-sol).
# AI_API=chat

# ─── Observability ───
# LOG_LEVEL: error | warn | info | debug. Full SQL text is logged ONLY at debug
# (filter values can contain personal data: keep production at info).
# LOG_FORMAT: pretty (dev) | json (one JSON object per line, for log aggregators).
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# Durable NDJSON copy of every audit record, written BEFORE the DB insert:
# the replay source if audit DB writes fail. GET /health reports sink status.
# ROSIE_AUDIT_FILE=./logs/rosie-audit.ndjson
# Each record is written to that file before its answer is sent, so a crash of the server
# loses nothing. Set this to true to also flush to the device on every record, so a crash of
# the HOST loses nothing either (one fsync per question). In a container, mount a volume on
# the file's directory or the file goes away with the container (docs/INSTALL.md).
# ROSIE_AUDIT_FSYNC=false
# Governance policy when the audit trail cannot record:
# fail-open (default) keeps answering while at least the NDJSON file preserves
# evidence; fail-closed refuses /ask, /export and /explain (503) while NO sink
# (neither DB nor file) can record request outcomes.
# ROSIE_AUDIT_POLICY=fail-open
# How long audit records are kept, in days. 0 (the default) keeps everything. Nothing is removed
# by the server: `npm run audit-prune -- --confirm` removes the records older than this from
# rosie_audit_log, rosie_answer_certificate, rosie_feedback and the audit file, with an
# administrator connection (ROSIE_ADMIN_DB_URL, given to that command only, never in this file).
# Schedule it daily. docs/COMPLIANCE.md.
# ROSIE_AUDIT_RETENTION_DAYS=0
# How often the read-only-user privilege probe re-runs, in ms, from 60000 to 86400000.
# ROSIE_PERMCHECK_INTERVAL_MS=900000
# Who protects the masked columns: express (default) or strict. Any other value: Rosie refuses
# to start.
#   express  Rosie's validator refuses statements that reach a masked column and leaves masked
#            columns out of what it describes to the model; the read-only account may hold
#            SELECT on the whole schema (or database on MySQL), so it can read those columns.
#            The startup log has one info line per context (masking_mode_express).
#   strict   the database must deny the masked columns too (column grants: `npm run grants`),
#            verified at startup, with the validator on top. ROSIE_REQUIRE_COLUMN_GRANTS
#            defaults to true. On SQL Server column grants do not stop a PIVOT, so strict holds
#            every request there unless the masked tables are read through reviewed views.
# An installation upgrading without this line is express (the gate stays off, as before).
# ROSIE_MASKING_MODE=express
# The masked-column grant check runs on the same schedule, and after every context reload, in
# both modes. With ROSIE_REQUIRE_COLUMN_GRANTS on, a context that is not "masked by the database" or "no masked columns" (a
# masked column the read-only account or a role it can switch to can read, also through a
# PostgreSQL partition or a MySQL histogram, an unmasked catalog column it cannot, a catalog
# view without "reviewedView": true, a view or definer routine returning a masked column or
# that the check cannot read, a check that could not run or has not run yet, "not verified on
# SQL Server") refuses
# /ask, /export, /explain, /certify and the MCP tools until it is (HTTP 503, codes
# E_COLUMN_GRANTS_*). On SQL Server, column grants alone are "masked by Rosie only" (PIVOT),
# so this holds every request there unless the masked tables are read through reviewed views
# (docs/SQLSERVER.md). A reload keeps the old context serving until the new one is checked.
# /health and the admin overview show the hold. Default: true in strict mode, false in express
# mode. Set explicitly, it wins over the mode's default in both directions.
# ROSIE_REQUIRE_COLUMN_GRANTS=
# With ROSIE_REQUIRE_COLUMN_GRANTS on, a passing check is valid for a limited time, counted from
# the start of the check as the larger of the monotonic and the wall-clock age: past it,
# requests are refused with E_COLUMN_GRANTS_NOT_CHECKED until a new check passes. Default: two
# check intervals plus five minutes (35 minutes at the default interval), at most 24 hours.
# From 60000 to 86400000; any other value stops the server.
# ROSIE_COLUMN_GRANTS_MAX_AGE_MS=
# The deadline of one context's check, in ms. A check still running then counts as failed
# ("not checked", error check_timeout). Default 120000; from 1000 to 3600000.
# ROSIE_COLUMN_GRANTS_CHECK_TIMEOUT_MS=120000
# How often the catalog is compared with the database, in ms (default one hour; 0 turns the
# check off, otherwise from 60000 to 604800000). A table or column the catalog names and the database no longer has
# is logged, counted in /metrics, and suspends the approved queries that read it
# (docs/OPERATIONS.md). Also runs at startup and after a context reload.
# ROSIE_SCHEMA_DRIFT_INTERVAL_MS=3600000
# Where `npm run evaluate` keeps its runs (docs/EVALUATION.md). Default: eval/runs inside the
# context directory. Set it to a writable directory when the context is mounted read-only;
# the server reads the last run from the same place to expose rosie_evaluation_* metrics.
# ROSIE_EVAL_DIR=

# ─── DB (main pool, used ONLY for Rosie's own four engine tables: rosie_audit_log,
#     rosie_answer_certificate, rosie_feedback, rosie_rate_limit) ───
# Database engine: mysql (default), postgres, or mssql (SQL Server; docs/SQLSERVER.md). MariaDB is
# not supported: DB_DIALECT=mariadb stops the server at startup with that message.
# DB_DIALECT=mysql
# PostgreSQL and SQL Server. DB_SCHEMA is the ONE schema Rosie reads (default public on
# PostgreSQL, dbo on SQL Server; on PostgreSQL it becomes the search_path of the
# read-only pool; schema-qualified names are rejected).
# PostgreSQL only. DB_ENGINE_SCHEMA is where the engine tables live inside the engine
# database. It is not read on SQL Server, where they are found in the default schema of the
# main account.
# DB_SCHEMA=public
# DB_ENGINE_SCHEMA=public
# TLS to the database, on every engine: true (encrypt and verify the server certificate),
# no-verify (encrypt, accept any certificate), or unset (no TLS unless the server forces it).
# Use true whenever the database is not on the same host or private network.
# DB_SSL=true
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_DATABASE=your_database_name

# RECOMMENDED: a dedicated schema for Rosie's engine tables, so no write-capable Rosie
# credential has grants on the data schema and the read-only user cannot read them.
# Create it, apply db/schema.sql inside it, and scope the main user to it (MySQL):
#   CREATE DATABASE rosie;
#   GRANT SELECT, INSERT ON rosie.* TO 'rosie_app'@'%';
# With ROSIE_RATE_LIMIT_STORE=database the main user also needs, after the tables exist:
#   GRANT UPDATE, DELETE ON rosie.rosie_rate_limit TO 'rosie_app'@'%';
# The account that runs `npm run retention -- --confirm` needs DELETE on rosie_audit_log,
# rosie_answer_certificate and rosie_feedback; it can be another account.
# `npm run doctor` checks that the tables are there, not these grants.
# Statements for every engine: docs/INSTALL.md (Step 3), docs/POSTGRES.md, docs/SQLSERVER.md.
# npm run init creates the database and the tables with --create-engine-tables --engine-db.
# Unset, engine tables are expected in DB_DATABASE (legacy layout).
# DB_ENGINE_DATABASE=rosie

# ─── DB (read-only pool: MUST be a user with only SELECT privileges) ───
# What it is granted depends on ROSIE_MASKING_MODE:
#   express (the default)  SELECT on the database (MySQL) or the schema is what the wizard
#                          grants: Rosie's validator refuses the masked columns.
#                            GRANT SELECT ON your_database_name.* TO 'rosie_readonly'@'%';
#   strict                 the database denies the masked columns too: SELECT table by table
#                          and, on tables with masked columns, only the unmasked columns. Then
#                          never the whole database or schema: a narrower grant does not remove
#                          a broader one, so the masked columns would stay readable.
#                            GRANT SELECT ON your_database_name.orders TO 'rosie_readonly'@'%';
#                            GRANT SELECT (id, first_name, city) ON your_database_name.customers TO 'rosie_readonly'@'%';
# `npm run init -- --create-ro-user` creates the account with the grants of the mode chosen;
# `npm run -s grants` prints the strict ones from the catalog. docs/INSTALL.md Step 2.
# DB_RO_HOST=localhost
# DB_RO_PORT=3306
# DB_RO_USER=rosie_readonly
# DB_RO_PASSWORD=
# DB_RO_DATABASE=your_database_name

# ─── Project-specific context (must point to a project's rosie-context dir) ───
# The server refuses to start, with one line saying which, when it is unset, missing, lacks a
# required file or carries a value the prompt cannot (a calendar month 13).
# ROSIE_CONTEXT_DIR=/absolute/path/to/your-project/rosie-context
