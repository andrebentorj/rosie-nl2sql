# ─── Server ───
ROSIE_PORT=3001
ROSIE_CORS_ORIGIN=http://localhost:4200
# Behind a reverse proxy (nginx/ALB), set to the number of proxy hops (usually 1) so
# rate limiting sees the real client IP instead of the proxy's. Without it, ALL users
# behind the proxy share one rate-limit bucket. Never use "true" in production — it
# trusts any client-supplied X-Forwarded-For and makes limits spoofable.
# TRUST_PROXY=1

# Set to "production" to make auth FAIL-CLOSED: with NODE_ENV=production and no
# ROSIE_API_TOKEN, every request is refused (503) instead of running unauthenticated.
# Anything else (or unset) is treated as development.
# NODE_ENV=production

# ─── Auth (production: set to a long random string; dev: leave empty) ───
# ROSIE_API_TOKEN=

# ─── Verified identity (JWT). Needed for row policies; optional otherwise ───
# When ROSIE_JWT_ISSUER is set, a bearer token that is a JWT is verified (signature, issuer,
# audience, expiry) and its claims become the identity of the request. ROSIE_API_TOKEN keeps
# working alongside it for callers without a user token, but carries no claims.
# Only asymmetric algorithms are accepted. See docs/IDENTITY.md.
# ROSIE_JWT_ISSUER=https://login.example.com/
# ROSIE_JWT_AUDIENCE=rosie
# ROSIE_JWT_JWKS_URL=https://login.example.com/.well-known/jwks.json
# Alternative to the URL: the public key set itself, as JSON (air-gapped installs).
# ROSIE_JWT_JWKS=
# ROSIE_JWT_ALGORITHMS=RS256,ES256,PS256,EdDSA
# ROSIE_JWT_USER_CLAIM=sub
# ROSIE_JWT_NAME_CLAIM=name
# Expose a namespaced claim under the short name row policies use:
# ROSIE_JWT_CLAIM_MAP={"tenant_id":"https://example.com/tenant"}
# MCP over HTTP only: a scope the token must carry (default: any valid token for the audience).
# ROSIE_MCP_HTTP_REQUIRED_SCOPE=

# ─── MCP over Streamable HTTP (stdio needs none of these) ───
# Off unless true. Stateless transport behind bearer auth; bind to loopback and put a TLS
# proxy in front. See docs/MCP_SERVER.md "Remote transport".
# ROSIE_MCP_HTTP_ENABLED=false
# ROSIE_MCP_HTTP_HOST=127.0.0.1
# ROSIE_MCP_HTTP_PORT=3002
# URL clients use (what the proxy exposes). When set, tokens are audience-bound to it
# (RFC 8707): a token minted for another resource is refused.
# ROSIE_MCP_HTTP_PUBLIC_URL=
# STATIC bearer token, used only when ROSIE_JWT_ISSUER is not set (preview, local trials).
# Min 24 chars; one identity, no claims. With JWT configured, tokens are verified instead.
# ROSIE_MCP_HTTP_TOKEN=

# Identity recorded for questions arriving through the local MCP server (stdio). Audit and
# handle ownership only, never authorization: over stdio the trust boundary is the machine.
# ROSIE_MCP_USER=mcp-local

# Key that signs the answer handles /export and /explain authorize with. Minimum 16 chars.
# Unset, a random key is generated per process: handles then stop working after a restart
# and are NOT accepted by a sibling replica, so set this before running more than one
# instance. Rotating it invalidates every outstanding handle (worst case: users re-run a
# question), so rotation is cheap.
# ROSIE_HANDLE_SECRET=

# ─── AI ───
# Provider-pluggable via an OpenAI-compatible wire format.
#   • Default (OpenAI):   leave AI_BASE_URL empty, AI_MODEL=gpt-6-luna, OPENAI_API_KEY=sk-...
#   • Claude (Anthropic): AI_BASE_URL=https://api.anthropic.com/v1/
#                         AI_MODEL=claude-haiku-5-5   (or claude-sonnet-5-5)
#                         OPENAI_API_KEY=sk-ant-...   (the var name stays OPENAI_API_KEY)
#   • Any gateway (OpenRouter, LiteLLM): set AI_BASE_URL to its endpoint + matching key/model.
# AI_BASE_URL=
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-6-luna
# Kill switch: set to false (and restart) to disable every assistant endpoint —
# the documented emergency stop.
AI_ASSISTANT_ENABLED=true
# Per-IP limits. Each endpoint group (/ask, /export, /explain, /feedback) counts
# against its OWN bucket with these same ceilings.
AI_MAX_QUERIES_PER_HOUR=100
AI_MAX_QUERIES_PER_DAY=1000
# Circuit breaker for the AI provider (consecutive infra failures before
# short-circuiting, and cooldown before retrying).
# AI_CIRCUIT_BREAKER_THRESHOLD=5
# AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000
# Per-statement DB timeout for AI-generated queries, in ms (MySQL MAX_EXECUTION_TIME
# on the read-only pool — SELECTs only). Raise for deployments with heavy reports.
# AI_QUERY_TIMEOUT_MS=10000
# Max tokens the model may generate per reply (sent as max_completion_tokens).
# AI_MAX_TOKENS=2048
# Sampling temperature. Unset = model-aware default: 0 for the gpt-4 generation (historical
# behaviour), omitted for everything else (current models reject an explicit value unless
# reasoning is off). Set explicitly to override.
# AI_TEMPERATURE=
# Reasoning effort for models that have one. Unset = 'none' for gpt-5+ families (the only
# value that allows function tools on chat.completions) and omitted for older models, which
# reject the argument. Run `node test/provider/smoke.js` after changing model or provider.
# AI_REASONING_EFFORT=
# Max characters accepted in a single question; longer ones are refused before the LLM.
# AI_MAX_INPUT_LENGTH=500
# Simultaneous in-flight /ask, /export and /explain requests. NOTE: this is PER PROCESS,
# so N replicas allow N times this number until shared state lands.
# AI_CONCURRENCY_LIMIT=3

# ─── Per-request ceilings (bound the work INSIDE one question, unlike the rate
#     limits above, which bound how many questions arrive) ───
# Loop turns the model may take before it is forced to answer.
# AI_MAX_TOOL_CALLS=20
# DB-touching queries per question. execute_query and validate_query each get their own
# bucket with this same ceiling; further attempts are refused and the model must answer.
# AI_MAX_QUERIES_PER_REQUEST=5
# Accumulated LLM tokens per question before a final answer is forced. 0 = OFF.
# The real cost guard when AI_BASE_URL points at an expensive model.
# AI_MAX_TOTAL_TOKENS=0
# Rows of a query result serialized back to the MODEL (the user always gets the full
# result). Default 30. 0 = OFF, meaning the whole result goes into the context.
# AI_LLM_RESULT_MAX_ROWS=30

# ─── Schema retrieval (large catalogs only) ───
# Catalogs with this many tables or fewer are always sent whole, byte-identical to the
# baseline prompt. Above it, the prompt is rebuilt with only the relevant tables.
# 0 disables the feature entirely. The security allowlist is NEVER affected by selection.
# AI_SCHEMA_MAX_TABLES=40
# Upper bound on how many tables the selector may pick for one question.
# AI_SCHEMA_TOPK=15
# Inline every table's (unmasked) column names, type family and enum codes in the prompt
# catalog, so the model writes SQL without a describe_table call per table. Costs a few
# thousand cached prompt tokens; saves one or two LLM round-trips per question.
# AI_CATALOG_COLUMNS=true

# Answer Certificate — deterministic post-answer checks (fan-out, nonexistent filter
# value, no-op filter, partial period) shipped to the client with every answer.
# Read-only probes, no LLM cost. Set to false to disable.
# AI_ANSWER_CHECKS=true
# Independent double derivation: re-derives single-value aggregates over a join by a
# deduplicated route and compares the two figures, which gives the CROSS_CHECKED and
# CONTRADICTED verdicts. Costs one extra read-only query on qualifying answers, no LLM.
# Requires the cross_check column (see db/schema.sql). Default ON; false turns it off.
# AI_CROSS_CHECK=true

# ─── Observability ───
# LOG_LEVEL: error | warn | info | debug. Full SQL text is logged ONLY at debug
# (filter values can contain personal data — keep production at info).
# LOG_FORMAT: pretty (dev) | json (one JSON object per line, for log aggregators).
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# Durable NDJSON copy of every audit record, written BEFORE the DB insert —
# the replay source if audit DB writes fail. GET /health reports sink status.
# ROSIE_AUDIT_FILE=./logs/rosie-audit.ndjson
# Governance policy when the audit trail cannot record:
# fail-open (default) keeps answering while at least the NDJSON file preserves
# evidence; fail-closed refuses /ask, /export and /explain (503) while NO sink
# (neither DB nor file) can record request outcomes.
# ROSIE_AUDIT_POLICY=fail-open
# How often the read-only-user privilege probe re-runs, in ms (min 60000).
# ROSIE_PERMCHECK_INTERVAL_MS=900000

# ─── DB (main pool — used ONLY for Rosie's own engine tables: audit log + feedback) ───
# Database engine: mysql (default; also MariaDB), postgres, or mssql (SQL Server; docs/SQLSERVER.md).
# DB_DIALECT=mysql
# PostgreSQL and SQL Server. DB_SCHEMA is the ONE schema Rosie reads (default public on
# PostgreSQL, dbo on SQL Server; on PostgreSQL it becomes the search_path of the
# read-only pool; schema-qualified names are rejected). DB_ENGINE_SCHEMA is where the engine
# tables live inside the engine database. DB_SSL: true (verify the certificate), no-verify, or unset.
# DB_SCHEMA=public
# DB_ENGINE_SCHEMA=public
# DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=your_database_name

# RECOMMENDED: a dedicated schema for Rosie's engine tables (rosie_audit_log,
# rosie_feedback), so no write-capable Rosie credential has grants on the data
# schema. Create it and scope the main user to it:
#   CREATE DATABASE rosie;
#   GRANT SELECT, INSERT ON rosie.* TO 'rosie_app'@'%';
# Then apply db/schema.sql inside it (npm run init offers to do all of this).
# Unset, engine tables are expected in DB_DATABASE (legacy layout).
# DB_ENGINE_DATABASE=rosie

# ─── DB (read-only pool — MUST be a user with only SELECT privileges) ───
# Create the user with:
#   CREATE USER 'rosie_readonly'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON your_database_name.* TO 'rosie_readonly'@'%';
DB_RO_HOST=localhost
DB_RO_PORT=3306
DB_RO_USER=rosie_readonly
DB_RO_PASSWORD=
DB_RO_DATABASE=your_database_name

# ─── Project-specific context (must point to a project's rosie-context dir) ───
ROSIE_CONTEXT_DIR=/absolute/path/to/your-project/rosie-context
